# BYOK: use your own password, provider accounts and hosting.
# Add your own Twitch Client ID and WoopSocial key in Settings; none are bundled.
# Local Whisper/Gaming inference does not require an OpenAI API key.
# Set your own owner password before exposing the server.
AUTOPILOT_PASSWORD=
DATA_DIR=./data
HOST=127.0.0.1
PORT=8877
# Cloud deployments mount a persistent volume at DATA_DIR.
# Optionally set a persistent Fernet key instead of the generated data/encryption.key file.
AUTOPILOT_ENCRYPTION_KEY=
WHISPER_MODEL=base.en
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
